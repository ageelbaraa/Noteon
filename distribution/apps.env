# Public Firebase App IDs for Noteon App Distribution (not secrets).
# Source of truth also appears in google-services.json / GoogleService-Info.plist.

FIREBASE_PROJECT_ID=noteon-app
FIREBASE_ANDROID_APP_ID=1:986236984899:android:9a3661d72fc7509eb23ef6
FIREBASE_IOS_APP_ID=1:986236984899:ios:30f9adc5d32fe343b23ef6

# Optional: create a group in Firebase Console → App Distribution → Testers & Groups
# then set the alias here (comma-separated). Leave empty to upload without notifying testers.
FIREBASE_TESTER_GROUPS=Dev
